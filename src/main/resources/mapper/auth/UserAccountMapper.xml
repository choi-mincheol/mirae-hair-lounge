<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mirae.hairlounge.auth.mapper.UserAccountMapper">

    <sql id="columns">
        id, login_id, name, password_hash, role, enabled, created_at
    </sql>

    <select id="findByLoginId" resultType="com.mirae.hairlounge.auth.domain.UserAccount">
        SELECT <include refid="columns"/>
        FROM user_account
        WHERE login_id = #{loginId}
    </select>

    <select id="findById" resultType="com.mirae.hairlounge.auth.domain.UserAccount">
        SELECT <include refid="columns"/>
        FROM user_account
        WHERE id = #{id}
    </select>

    <select id="countByRole" resultType="int">
        SELECT COUNT(*)
        FROM user_account
        WHERE role = #{role}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO user_account (login_id, name, password_hash, role, enabled, created_at)
        VALUES (#{loginId}, #{name}, #{passwordHash}, #{role}, #{enabled}, #{createdAt})
    </insert>
</mapper>
